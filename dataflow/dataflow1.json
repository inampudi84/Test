{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText2",
						"type": "DatasetReference"
					},
					"name": "Readinghistory"
				}
			],
			"sinks": [],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          Date as string,",
				"          Due_Date as string,",
				"          Eff_Date as string,",
				"          Tran_Amt as string,",
				"          Principal as string,",
				"          Interest as string,",
				"          Escrow as string,",
				"          Fees as string,",
				"          Suspense as string,",
				"          Description as string,",
				"          Principal_Balance as string,",
				"          Escrow_Balance as string,",
				"          Suspense_Balance as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     limit: 100,",
				"     ignoreNoFilesFound: false,",
				"     partitionBy('key',",
				"          0,",
				"          ERROR_FUNCTION('')",
				"     )) ~> Readinghistory"
			]
		}
	}
}