{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText2",
						"type": "DatasetReference"
					},
					"name": "Readinghistory"
				}
			],
			"sinks": [],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          Date as date 'MM/dd/yyyy',",
				"          Due_Date as date 'MM/dd/yyyy',",
				"          Eff_Date as date 'MM/dd/yyyy',",
				"          Tran_Amt as decimal(10,0),",
				"          Principal as decimal(10,0),",
				"          Interest as decimal(10,0),",
				"          Escrow as decimal(10,0),",
				"          Fees as decimal(10,0),",
				"          Suspense as string,",
				"          Description as string,",
				"          Principal_Balance as decimal(10,0),",
				"          Escrow_Balance as decimal(10,0),",
				"          Suspense_Balance as decimal(10,0)",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     limit: 100,",
				"     ignoreNoFilesFound: false) ~> Readinghistory"
			]
		}
	}
}