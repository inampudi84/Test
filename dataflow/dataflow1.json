{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText2",
						"type": "DatasetReference"
					},
					"name": "Readinghistory"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText3",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "ls_ADLS",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          name as string,",
				"          version as string,",
				"          edition as string,",
				"          cores as string,",
				"          hostType as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: true,",
				"     inferDriftedColumnTypes: true,",
				"     limit: 100,",
				"     ignoreNoFilesFound: false,",
				"     partitionBy('hash', 1)) ~> Readinghistory",
				"Readinghistory sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Date as string,",
				"          Due_Date as string,",
				"          Eff_Date as string,",
				"          Tran_Amt as string,",
				"          Principal as string,",
				"          Interest as string,",
				"          Escrow as string,",
				"          Fees as string,",
				"          Suspense as string,",
				"          Description as string,",
				"          Principal_Balance as string,",
				"          Escrow_Balance as string,",
				"          Suspense_Balance as string",
				"     ),",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}